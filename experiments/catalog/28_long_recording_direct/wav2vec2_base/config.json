{
  "experiment": "28_long_recording_direct/wav2vec2_base",
  "mode": "evaluate",
  "model": {
    "family": "wav2vec2_base",
    "pretrained": "facebook/wav2vec2-base",
    "requires_checkpoint": true,
    "checkpoint_env": "ASR_WAV2VEC2_BASE_CHECKPOINT",
    "init_checkpoint": "outputs/07_public_elderly_aug/wav2vec2_base/final"
  },
  "data": {
    "train_manifest": null,
    "validation_manifest": null,
    "tests": {
      "elderly_long": "data/manifests/elderly_long/test.jsonl"
    }
  },
  "augmentation": {
    "enabled": false,
    "exclude": [],
    "background_dir": "data/augmentation/background_train",
    "rir_dir": "data/augmentation/rir_train"
  },
  "training": {
    "output_dir": "outputs/28_long_recording_direct/wav2vec2_base",
    "epochs": 10,
    "batch_size": 4,
    "gradient_accumulation": 8,
    "learning_rate": 0.0003,
    "seed": 42
  },
  "evaluation": {
    "vad": false,
    "window_seconds": 20
  }
}